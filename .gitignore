app.*.symbols
app.*.map.json

# Android Studio Build Artifacts
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview Cache
.widget_preview/

# Sensitive Keys & Credentials
*.keystore
*.jks
key.properties
.env
.env.*
!.env.example
